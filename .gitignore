# agent-harness:project-gitignore:v1:start
# Managed block. Its source is .agents/templates/gitignore in the harness repository; edit it
# there and re-run EnsureProject. Anything you add outside these markers is preserved.

# Task-hook runtime state. hook-state.js writes <repo-root>/taskstate/<project-id>/ by its own
# design -- session-local records, allow-tag usage among them -- which belong to one device and
# one session rather than to the project. It was never ignored, so every project running the
# hooks accumulated an untracked directory in its root that a `git add -A` would commit.
taskstate/

# The pre-relocation location for the same state. A session that predates the move still writes
# here, so a project can acquire this directory without any current tool creating it.
.claude/state/
# agent-harness:project-gitignore:v1:end

.local/
.validator-deps/
node_modules/
package-lock.json
!storefront/package-lock.json
.vercel/

# Local interpreter and guarded-state runtime artifacts.
__pycache__/
*.pyc
.agents/work/state.lock
*.lock.json

# Real customer data, kept out of Git by a rule rather than by luck.
#
# The conversion scripts write customers.csv and orders.jsonl -- 2,212 real people and 1,154 real
# orders -- under PROJECT_DATA_ROOT, which resolves outside this repository. That is a path
# convention, and two environment variables can change it: PROJECT_DATA_ROOT and MT_EXPORT_DIR.
# If either points somewhere unexpected the output root is derived by a regex replace that silently
# no-ops, and the PII lands wherever the script was run. These two lines are the mechanical backstop
# so the policy does not depend on the path holding.
outputs/
db/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Work Scope keeps rolling state backups and pre-migration schema copies. They are recovery
# artifacts for one machine, not shared project state.
.agents/work/backups/
.agents/work/*.bak
STATUS.md.lock.json
