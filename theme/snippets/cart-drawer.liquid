<div class="drawer__head">
  <h2 id="cart-drawer-title" style="margin:0;font-size:1rem;">Your order</h2>
  <button class="btn btn--ghost" type="button" data-cart-close>Close</button>
</div>
<div class="drawer__body" data-cart-body>
  <p class="hint" data-cart-empty>Nothing on the ticket yet.</p>
  <div data-cart-lines></div>
</div>
<div class="drawer__foot">
  <p style="display:flex;justify-content:space-between;margin:0;font-weight:700;">
    <span>Subtotal</span><span data-cart-total>$0.00</span>
  </p>
  <p class="hint">Decoration, hemming, and agency pricing are confirmed on the order ticket before payment.</p>
  <a class="btn btn--accent btn--full" href="#" data-cart-checkout>Continue to checkout</a>
</div>
