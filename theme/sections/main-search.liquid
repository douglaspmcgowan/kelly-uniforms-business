<div class="shell" style="padding:1.5rem 0 3rem;">
  <h1 style="font-size:1.5rem;margin:0 0 .25rem;">Search</h1>
  <p class="hint" style="margin:0 0 1.25rem;">
    {%- if search.terms != blank -%}
      {%- comment -%}
        `| escape` because neither runtime auto-escapes `{{ }}`. Shopify sanitizes `search.terms`
        server-side, so this is defensive there; the liquidjs preview has no such sanitizer, so it
        is not defensive here. The filter costs nothing and removes the question in both.
      {%- endcomment -%}
      {{ search.results_count | default: search.results.size }} results for &ldquo;{{ search.terms | escape }}&rdquo;
    {%- else -%}
      Search by item name, model number, or the agency it is issued to.
    {%- endif -%}
  </p>

  {%- if search.results.size > 0 -%}
    <div class="grid">
      {%- for product in search.results -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>
  {%- elsif search.terms != blank -%}
    <p>Nothing matched that. Try a shorter term, or
       <a href="/pages/contact">ask us</a> — a lot of what we sell is ordered in.</p>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Search results", "settings": [] }
{% endschema %}
