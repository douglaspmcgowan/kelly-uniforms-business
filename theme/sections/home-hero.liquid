<div class="shell" style="padding:2.5rem 0 1rem;">
  <div style="max-width:var(--measure);">
    <p class="card__eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 style="font-size:clamp(1.75rem,4vw,2.5rem);line-height:1.15;margin:.25rem 0 .75rem;">
      {{ section.settings.heading }}
    </h1>
    <p style="font-size:1.0625rem;color:var(--steel);margin:0 0 1.25rem;">{{ section.settings.body }}</p>
    <p style="display:flex;gap:.625rem;flex-wrap:wrap;">
      <a class="btn btn--accent" href="{{ routes.all_products_collection_url | default: '/collections/all' }}">Browse the catalog</a>
      <a class="btn btn--ghost" href="/pages/departments">Set up a department account</a>
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Home hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Johnstown, Pennsylvania" },
    { "type": "text", "id": "heading", "label": "Heading",
      "default": "Uniforms and duty gear, fitted by people who know the job." },
    { "type": "textarea", "id": "body", "label": "Body",
      "default": "Police, fire, EMS, corrections, constables, and postal carriers across western Pennsylvania. Stocked locally, tailored in house, and backed by a counter you can actually call." }
  ]
}
{% endschema %}
