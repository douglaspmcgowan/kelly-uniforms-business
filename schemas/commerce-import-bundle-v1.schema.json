{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtuniforms.local/schemas/commerce-import-bundle-v1.schema.json",
  "title": "MT Uniforms commerce import bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "source_system",
    "store_ref",
    "captured_at",
    "source_version",
    "capture_method",
    "status",
    "scope",
    "artifacts",
    "reconciliation"
  ],
  "properties": {
    "schema_version": {"const": "mt-uniforms-commerce-import/v1"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "source_system": {"enum": ["opencart", "ecwid"]},
    "store_ref": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "source_version": {"type": "string", "minLength": 1},
    "capture_method": {"type": "string", "minLength": 1},
    "status": {"const": "reconciled"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entities"],
      "properties": {
        "kind": {"enum": ["complete", "partial"]},
        "entities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "artifact_type", "sha256", "bytes", "record_count", "completeness", "entity"],
        "properties": {
          "relative_path": {"type": "string", "minLength": 1},
          "artifact_type": {"enum": ["database-sql", "table-snapshot", "ui-csv", "api-page", "media", "configuration", "log"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "record_count": {"type": "integer", "minimum": 0},
          "completeness": {"enum": ["complete-file", "complete-window", "partial-documented"]},
          "entity": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_counts", "normalized_counts", "skipped_counts", "skips", "foreign_key_errors", "unresolved_conflicts", "money_checks"],
      "properties": {
        "source_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "normalized_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "skipped_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "skips": {"type": "array", "items": {"type": "object"}},
        "foreign_key_errors": {"const": 0},
        "unresolved_conflicts": {"const": 0},
        "money_checks": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
